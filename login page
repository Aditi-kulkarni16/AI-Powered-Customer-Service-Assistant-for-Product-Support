<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>AI Support System</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family: "Poppins", sans-serif;
}

body{
height:100vh;
display:flex;
justify-content:center;
align-items:center;
background: linear-gradient(135deg,#e8f5e9,#c8e6c9,#a5d6a7);
}

/* Card */

.login-card{
width:380px;
padding:40px;
background:white;
border-radius:18px;
box-shadow:0 20px 40px rgba(0,0,0,0.12);
text-align:center;
}

/* Title */

.login-card h1{
font-size:26px;
color:#1b5e20;
margin-bottom:8px;
}

.login-card p{
color:#666;
font-size:14px;
margin-bottom:30px;
}

/* Inputs */

.input-group{
margin-bottom:18px;
text-align:left;
}

.input-group label{
font-size:13px;
color:#444;
}

.input-group input{
width:100%;
padding:12px;
margin-top:6px;
border-radius:8px;
border:1px solid #ddd;
font-size:14px;
transition:0.3s;
}

.input-group input:focus{
border-color:#2e7d32;
outline:none;
box-shadow:0 0 0 2px rgba(46,125,50,0.1);
}

/* Button */

.login-btn{
width:100%;
padding:12px;
background:#2e7d32;
color:white;
border:none;
border-radius:10px;
font-size:15px;
cursor:pointer;
transition:0.3s;
}

.login-btn:hover{
background:#1b5e20;
}

/* Links */

.links{
margin-top:15px;
font-size:13px;
display:flex;
justify-content:space-between;
}

.links a{
text-decoration:none;
color:#2e7d32;
}

/* Footer */

.footer{
margin-top:25px;
font-size:12px;
color:#777;
}

</style>
</head>

<body>

<div class="login-card">

<h1>AI Support</h1>
<p>Intelligent Product Support System</p>

<form>

<div class="input-group">
<label>Email</label>
<input type="email" placeholder="Enter your email">
</div>

<div class="input-group">
<label>Password</label>
<input type="password" placeholder="Enter your password">
</div>

<button class="login-btn">Login</button>

<div class="links">
<a href="#">Forgot Password</a>
<a href="#">Create Account</a>
</div>

<div class="footer">
AI Customer Service Assistant
</div>

</form>

</div>

</body>
</html>
