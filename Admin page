<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>FixNest Admin</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:"Segoe UI",sans-serif;
}

body{
background:linear-gradient(to right,#eef7f0,#e3f2e8);
padding:20px;
}

/* HEADER */
h1{
text-align:center;
color:#1b5e20;
margin-bottom:20px;
}

.top-btn{
position:absolute;
top:20px;
right:20px;
}

.top-btn button{
background:#1b5e20;
color:white;
padding:10px 14px;
border:none;
border-radius:8px;
cursor:pointer;
}

/* DASHBOARD */
.dashboard{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-bottom:25px;
}

.card{
background:white;
padding:25px;
border-radius:16px;
box-shadow:0 10px 25px rgba(0,0,0,0.08);
text-align:center;
transition:0.3s;
}

.card:hover{
transform:translateY(-5px);
}

/* SECTIONS */
.section{
margin-top:25px;
}

.section h2{
color:#1b5e20;
cursor:pointer;
margin-bottom:10px;
}

/* FORM */
input{
padding:10px;
margin:8px 0;
border-radius:8px;
border:1px solid #ccc;
width:100%;
}

button{
padding:10px;
background:#2e7d32;
color:white;
border:none;
border-radius:8px;
cursor:pointer;
margin-top:10px;
}

button:hover{
background:#1b5e20;
}

/* SKILLS */
.skills label{
background:#e8f5e9;
padding:6px 10px;
border-radius:6px;
margin:5px;
display:inline-block;
cursor:pointer;
}

/* TABLE */
table{
width:100%;
background:white;
border-radius:12px;
overflow:hidden;
box-shadow:0 6px 18px rgba(0,0,0,0.08);
}

th{
background:#2e7d32;
color:white;
padding:12px;
}

td{
padding:10px;
border-bottom:1px solid #eee;
text-align:center;
}

tr:hover{
background:#f5faf7;
}

/* STATUS COLORS */
.available{ color:green; font-weight:bold; }
.busy{ color:red; font-weight:bold; }

/* ROW COLORS */
.completed-row{ background:#e8f5e9 !important; }
.assigned-row{ background:#fff8e1; }

select{
padding:6px;
border-radius:6px;
border:1px solid #ccc;
}

</style>
</head>

<body>

<h1>🚀 FixNest Admin Dashboard</h1>

<div class="top-btn">
<button onclick="goAnalytics()">📊 Analytics</button>
</div>

<!-- DASHBOARD -->
<div class="dashboard">
<div class="card">
<h2>Total Technicians</h2>
<p id="totalTech">0</p>
</div>

<div class="card">
<h2>Total Requests</h2>
<p id="totalRequests">0</p>
</div>

<div class="card">
<h2>Completed</h2>
<p id="completed">0</p>
</div>
</div>

<!-- ADD TECH -->
<div class="section">
<h2>➕ Add Technician</h2>

<input type="text" id="techName" placeholder="Technician Name">

<div class="skills">
<label><input type="checkbox" value="Table Fan">Fan</label>
<label><input type="checkbox" value="Electric Iron">Iron</label>
<label><input type="checkbox" value="Mixer Grinder">Mixer</label>
<label><input type="checkbox" value="Electric Kettle">Kettle</label>
<label><input type="checkbox" value="Vacuum Cleaner">Vacuum</label>
<label><input type="checkbox" value="LED Lamp">LED</label>
<label><input type="checkbox" value="Blender">Blender</label>
<label><input type="checkbox" value="Rice Cooker">Cooker</label>
<label><input type="checkbox" value="Extension Board">Extension</label>
<label><input type="checkbox" value="Toaster">Toaster</label>
</div>

<button onclick="addTech()">Add Technician</button>
</div>

<!-- TECH TABLE -->
<div class="section">
<h2 onclick="toggleSection('techSection')">👨‍🔧 Technicians ⬇</h2>
<div id="techSection">
<table id="techTable">
<tr><th>Name</th><th>Skills</th><th>Status</th></tr>
</table>
</div>
</div>

<!-- REQUEST TABLE -->
<div class="section">
<h2 onclick="toggleSection('requestSection')">📋 Requests ⬇</h2>
<div id="requestSection">
<table id="requestTable">
<tr>
<th>User</th><th>Email</th><th>Product</th>
<th>Date</th><th>Time</th><th>Status</th>
<th>Assign</th><th>Assigned</th>
</tr>
</table>
</div>
</div>

<script type="module">

import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, getDocs, addDoc, updateDoc, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const app = initializeApp({
apiKey:"AIzaSyCgKI-RxIdn2_LYhhBvsIx7etRYrXG4rig",
authDomain:"ai-customer-support-assi-5af0d.firebaseapp.com",
projectId:"ai-customer-support-assi-5af0d"
});

const db = getFirestore(app);

async function loadDashboard(){

techTable.innerHTML=`<tr><th>Name</th><th>Skills</th><th>Status</th></tr>`;
requestTable.innerHTML=`<tr>
<th>User</th><th>Email</th><th>Product</th>
<th>Date</th><th>Time</th><th>Status</th>
<th>Assign</th><th>Assigned</th></tr>`;

let techSnap=await getDocs(collection(db,"technicians"));
let reqSnap=await getDocs(collection(db,"technicianRequests"));

let techList=[], totalReq=0, completedCount=0;

techSnap.forEach(docData=>{
let d=docData.data();
techTable.innerHTML+=`
<tr>
<td>${d.name}</td>
<td>${d.skills.join(", ")}</td>
<td class="${d.available?'available':'busy'}">${d.available?"Available":"Busy"}</td>
</tr>`;
techList.push({id:docData.id,...d});
});

totalTech.innerText=techSnap.size;

reqSnap.forEach(docData=>{
let d=docData.data(); totalReq++;
if(d.status==="Completed") completedCount++;

let rowClass = d.status==="Completed" ? "completed-row" :
               d.status==="Assigned" ? "assigned-row" : "";

requestTable.innerHTML+=`
<tr class="${rowClass}">
<td>${d.name}</td>
<td>${d.email}</td>
<td>${d.product}</td>
<td>${d.preferredDate||"-"}</td>
<td>${d.preferredTime||"-"}</td>

<td>
<select onchange="updateStatus('${docData.id}',this.value)">
<option ${d.status=="Pending"?"selected":""}>Pending</option>
<option ${d.status=="Assigned"?"selected":""}>Assigned</option>
<option ${d.status=="Completed"?"selected":""}>Completed</option>
</select>
</td>

<td>
<select onchange="assignTech('${docData.id}',this.value)">
<option value="">Select</option>
${techList.filter(t=>t.available && t.skills.includes(d.product))
.map(t=>`<option value="${t.id}">${t.name}</option>`).join("")}
</select>
</td>

<td>${d.assignedTech||"-"}</td>
</tr>`;
});

totalRequests.innerText=totalReq;
completed.innerText=completedCount;
}

window.addTech=async()=>{
let name=techName.value.trim();
let skills=[...document.querySelectorAll(".skills input:checked")].map(e=>e.value);

if(!name||skills.length===0){alert("Enter name & skills");return;}

await addDoc(collection(db,"technicians"),{name,skills,available:true});
techName.value="";
document.querySelectorAll(".skills input").forEach(cb=>cb.checked=false);
loadDashboard();
};

window.assignTech=async(reqId,techId)=>{
if(!techId)return;

let techRef=doc(db,"technicians",techId);
let techSnap=await getDocs(collection(db,"technicians"));

let selected;
techSnap.forEach(d=>{if(d.id===techId) selected=d.data();});

await updateDoc(doc(db,"technicianRequests",reqId),{
assignedTech:selected.name,
assignedTechId:techId,
status:"Assigned"
});

await updateDoc(techRef,{available:false});
loadDashboard();
};

window.updateStatus=async(reqId,status)=>{
const ref=doc(db,"technicianRequests",reqId);
const snap=await getDoc(ref);
const data=snap.data();

if(status==="Completed" && !data.assignedTech){
alert("Assign technician first!");
loadDashboard(); return;
}

if(status==="Pending"){
if(data.assignedTechId){
await updateDoc(doc(db,"technicians",data.assignedTechId),{available:true});
}
await updateDoc(ref,{status:"Pending",assignedTech:"",assignedTechId:""});
}
else if(status==="Completed"){
if(data.assignedTechId){
await updateDoc(doc(db,"technicians",data.assignedTechId),{available:true});
}
await updateDoc(ref,{status:"Completed"});
}

loadDashboard();
};

loadDashboard();
window.goAnalytics=()=>window.location.href="analytics.html";

</script>

<script>
function toggleSection(id){
let el=document.getElementById(id);
el.style.display=el.style.display==="none"?"block":"none";
}
</script>

</body>
</html>
